# Copy to .env and edit — never commit .env
# Gateway (override config.yaml)
GATEWAY_HOST=10.1.156.12
GATEWAY_PORT=502

# PowerStudio
POWERSTUDIO_HOST=127.0.0.1
POWERSTUDIO_PORT=80

# Security — generate a 32-char random key for prod: python -c "import secrets; print(secrets.token_urlsafe(24))"
